# Application
APP_PORT=3000
APP_HOST="localhost${APP_PORT}"

# Database
# DB_DRIVER : see the 'type' option of https://typeorm.io/docs/data-source/data-source-options
DB_DRIVER=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=note_it

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (if enabled)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
